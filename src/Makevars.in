CXX_STD = CXX17

# Template: ../configure generates src/Makevars from this file, substituting
# the three @...@ tokens for either the system ICU4C (pkg-config) or the
# vendored bundle in src/icu78 (ICU4C 78.3; Unicode, Inc. and others; Unicode
# License v3, see src/icu78/LICENSE). Local source adjustments are summarized
# in src/icu78/UPSTREAM.md; package-specific configuration is supplied by
# compiler flags and src/uconfig_local.h. In bundle mode the
# U_HAVE_LIB_SUFFIX / U_LIB_SUFFIX_C_NAME pair renames every ICU C symbol to
# ...78_charr so charr's statically linked ICU never collides with stringi's
# or the system's at runtime; in system mode the suffix is off and the
# vendored headers stay OFF the include path.

# Keep R's short remapping macros from colliding with C++ member names.
PKG_CPPFLAGS = -DR_NO_REMAP -I. -Ialtrep_backend @ICU_CPPFLAGS@
# The ALTREP backend runs data-parallel kernels on std::thread workers.
# SHLIB_PTHREAD_FLAGS is what R knows this platform needs; it is empty where
# the C++ runtime needs nothing.
PKG_CXXFLAGS = $(SHLIB_PTHREAD_FLAGS)
PKG_LIBS = @ICU_LIBS@ $(SHLIB_PTHREAD_FLAGS)

RUNTIME_SOURCES = \
  runtime/icu.cpp \
  runtime/registration.cpp

RUNTIME_OBJECTS = $(RUNTIME_SOURCES:.cpp=.o)

SHARED_SOURCES = \
  shared/boundary_iterator.cpp \
  shared/case_mapper.cpp \
  shared/character_class.cpp \
  shared/character_class_search.cpp \
  shared/collation_ordering.cpp \
  shared/collation_search.cpp \
  shared/collator.cpp \
  shared/encoding_info.cpp \
  shared/fixed_search.cpp \
  shared/join.cpp \
  shared/line_split.cpp \
  shared/native_to_utf8.cpp \
  shared/nfc_normalizer.cpp \
  shared/parallel.cpp \
  shared/r_matrix.cpp \
  shared/read_lines.cpp \
  shared/regex_search.cpp \
  shared/repeat.cpp \
  shared/replacement.cpp \
  shared/substring.cpp \
  shared/title_case.cpp \
  shared/utf8.cpp \
  shared/wrap.cpp

SHARED_OBJECTS = $(SHARED_SOURCES:.cpp=.o)

BASE_FOUNDATION_SOURCES = \
  base_backend/boundary/options_r.cpp \
  base_backend/collator/options.cpp \
  base_backend/fixed/options.cpp \
  base_backend/regex/options_r.cpp

BASE_SOURCES = \
